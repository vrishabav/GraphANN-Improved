# Auto-normalize line endings
* text=auto

# Source code — always LF
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.tex text eol=lf

# Windows scripts — keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — don't touch
*.png binary
*.jpg binary
*.bin binary
*.fbin binary
*.ibin binary
